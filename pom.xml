<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.10</version>
        <relativePath/>
    </parent>

    <groupId>io.kuul</groupId>
    <artifactId>kuul-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>kuul</name>
    <description>Java-native, self-hosted, auditable enterprise Agent OS</description>
    <url>https://github.com/likun758/kuul</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>kuul-core</module>
        <module>kuul-storage</module>
        <module>kuul-governance</module>
        <module>kuul-provider</module>
        <module>kuul-memory</module>
        <module>kuul-tool</module>
        <module>kuul-channel</module>
        <module>kuul-web</module>
        <module>kuul-cli</module>
        <module>kuul-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.3</spring-ai.version>
        <mcp-sdk.version>2.1.0</mcp-sdk.version>
        <picocli.version>4.7.7</picocli.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- kuul modules -->
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-governance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kuul</groupId>
                <artifactId>kuul-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- third party -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
